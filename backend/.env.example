# Copy to .env and fill in values before running.

# REQUIRED in production — app exits on startup if missing when APP_ENV != development
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars

# Set to "production" in prod deployments to enforce strict checks
APP_ENV=development

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=routemate

# CORS — comma-separated list of allowed origins (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Optional: Google Maps API key for native map
GOOGLE_MAPS_API_KEY=
